{lfe_first_files, [
    "src/ltest-color.lfe",
    "src/ltest-const.lfe",
    "src/ltest-formatter.lfe",
    "src/ltest-integration.lfe",
    "src/ltest-listener.lfe",
    "src/ltest-runner.lfe",
    "src/ltest-system.lfe",
    "src/ltest-unit.lfe",
    "src/ltest-util.lfe",
    "src/ltest.lfe"
]}.

{deps, [
   {lfe, "2.2.2"},
   {color, "2.0.0", {pkg, erlang_color}}
]}.

{plugins, [
    {rebar3_lfe, "0.5.8"}
]}.

{project_plugins, [
    {rebar3_oscmd, "0.5.0"},
    {rebar3_hex, "7.5.0"}
]}.

{xref_checks,[
    undefined_function_calls,undefined_functions,locals_not_used,
    deprecated_function_calls,deprecated_functions
]}.

{dialyzer, [
    {warnings, [unknown]}
]}.

{profiles, [
   {test, [
      {eunit_opts, [verbose]},
      {erl_opts, [{src_dirs, ["src", "test"]}]},
      {lfe_first_files, [
          "test/ltest-basic-tests.lfe",
          "test/ltest-cancelled-tests.lfe",
          "test/ltest-fixture-tests.lfe",
          "test/ltest-fixturecase-tests.lfe",
          "test/ltest-formatter-tests.lfe",
          "test/ltest-generated-tests.lfe",
          "test/ltest-integration-tests.lfe",
          "test/ltest-macro-contract-tests.lfe",
          "test/ltest-named-tests.lfe",
          "test/ltest-skipped-tests.lfe",
          "test/ltest-system-tests.lfe",
          "test/ltest-testset-tests.lfe",
          "test/ltest-util-tests.lfe"
      ]}
   ]}
]}.

{commands, [
    {ltest, "make check-runner-ltest"},
    {'deps-dir', "echo $REBAR_DEPS_DIR"}
]}.

{alias, [
    {coverage, [
        {proper, "-c"},
        {cover, "-v --min_coverage=0"}
    ]},
    {check, [
        compile,
        %%xref,
        %%dialyzer,
        eunit,
        %%coverage,
        {oscmd, "ltest"}
    ]}
]}.
