{erl_first_files, ["src/ltest-util.lfe"]}.

{deps, [
   {lfe, "2.2.2"},
   {color, "2.0.0", {pkg, erlang_color}}
]}.

{project_plugins, [
    {rebar3_lfe, "0.5.8"},
    {rebar3_oscmd, "0.5.0"},
    {rebar3_hex, "7.5.0"}
]}.

{provider_hooks, [
    {pre, [{compile, {lfe, compile}}]}
]}.

{xref_checks,[
    undefined_function_calls,undefined_functions,locals_not_used,
    deprecated_function_calls,deprecated_functions
]}.

{dialyzer, [
    {warnings, [unknown]}
]}.

{profiles, [
   {test, [
      {eunit_opts, [verbose]},
      {erl_opts, [{src_dirs, ["src", "test"]}]}
   ]}
]}.

{commands, [
    {ltest, "make check-runner-ltest"},
    {'deps-dir', "echo $REBAR_DEPS_DIR"}
]}.

{alias, [
    {coverage, [
        {proper, "-c"},
        {cover, "-v --min_coverage=0"}
    ]},
    {check, [
        compile,
        %%xref,
        %%dialyzer,
        eunit,
        %%coverage,
        {oscmd, "ltest"}
    ]},
    {publish, [
        compile,
        {hex, "publish package"}
    ]}
]}.
